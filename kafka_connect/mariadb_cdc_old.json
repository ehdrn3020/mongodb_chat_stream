{
  "name": "mariadb-cdc-live",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "<mariadb-host>",
    "database.port": "3306",
    "database.user": "root",
    "database.password": "mystrongpassword!",

    "database.server.id": "1001",
    "topic.prefix": "mariadb",
    "database.include.list": "cdc_test",
    "table.include.list": "cdc_test.demo_title",
    "snapshot.mode": "schema_only",
    "include.schema.changes": "false",
    //"column.include.list": "cdc_test.demo_title.column1,cdc_test.demo_title.column2", 특정 컬럼만 조건

    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schemahistory.cdc_test",

    "decimal.handling.mode": "precise",
    "time.precision.mode": "connect",
    "provide.transaction.metadata": "true",
    "database.connectionTimeZone": "Asia/Seoul"
    //"tasks.max": 1 MariaDB(MySQL) 커넥터는 항상 single task이므로 tasks.max 변경 효과 없음
  }
}